# ============================================
# RAG + Agent 项目环境变量配置
# ============================================
# 复制此文件为 .env:
#   cp .env.example .env
#
# 然后编辑 .env，填入你购买/申请的 API Key
# ============================================

# ============================================
#  LLM 大模型配置（必填）
# ============================================
# 支持任意 OpenAI 兼容接口的服务商

# API Key —— 从你的 LLM 服务商获取
LLM_API_KEY=your-api-key-here

# API Base URL —— 各服务商地址不同，请按实际情况填写
LLM_API_BASE=https://api.openai.com/v1

# 模型名称
LLM_MODEL_NAME=gpt-4o

# API 请求超时秒数（可选，默认 60）
LLM_REQUEST_TIMEOUT=60

# ============================================
#  Embedding 配置（可选）
# ============================================
# 默认使用本地 BGE 模型（免费、无需 API，推荐中文场景）
# 如需使用远程 Embedding API，请取消下面注释并填写：

# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# ============================================
#  主流服务商配置示例
# ============================================

# --- OpenAI ---
# LLM_API_KEY=sk-your-openai-key
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o

# --- DeepSeek（性价比高，中文能力强）---
# LLM_API_KEY=sk-your-deepseek-key
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat

# --- 阿里百炼（通义千问）---
# LLM_API_KEY=sk-your-aliyun-key
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus

# --- 智谱 AI（GLM 系列）---
# LLM_API_KEY=your-zhipu-api-key
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL_NAME=glm-4-plus

# --- SiliconFlow（汇聚多种开源模型）---
# LLM_API_KEY=sk-your-siliconflow-key
# LLM_API_BASE=https://api.siliconflow.cn/v1
# LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# --- Moonshot（Kimi）---
# LLM_API_KEY=sk-your-moonshot-key
# LLM_API_BASE=https://api.moonshot.cn/v1
# LLM_MODEL_NAME=moonshot-v1-8k

# --- 零一万物（Yi 系列）---
# LLM_API_KEY=your-lingyi-api-key
# LLM_API_BASE=https://api.lingyiwanwu.com/v1
# LLM_MODEL_NAME=yi-large
